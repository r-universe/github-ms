[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "ExactTree"]
	path = ExactTree
	url = https://github.com/cran/ExactTree
[submodule "QR"]
	path = QR
	url = https://github.com/cran/QR
[submodule "metacart"]
	path = metacart
	url = https://github.com/cran/metacart
